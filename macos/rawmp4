#!/usr/bin/env bash
# rawmp4 – Organise raw image and movie files into dated folders

# Exit on errors, unset variables, and pipe failures
set -euo pipefail

# Enable case‑insensitive globbing and allow empty glob results
shopt -s nocasematch nullglob

# Default base directory is the current directory
BASE_DIR="${1:-.}"

# Ensure the base directory exists
if [[ ! -d "$BASE_DIR" ]]; then
  echo "Error: Directory '$BASE_DIR' does not exist." >&2
  exit 1
fi

# Create destination directories once
RAW_DIR="$BASE_DIR/raw"
MP4_DIR="$BASE_DIR/mp4"
mkdir -p "$RAW_DIR"
mkdir -p "$MP4_DIR"

# Loop through all files in the base directory
for file in "$BASE_DIR"/*; do
  # Skip if not a regular file
  [[ -f "$file" ]] || continue

  # Extract filename and extension
  filename=$(basename "$file")
  extension="${filename##*.}"
  filename_no_ext="${filename%.*}"

  # Skip JPG/JPEG files (they are the reference for the raw folder location)
  if [[ "$extension" == "JPG" || "$extension" == "JPEG" ]]; then
    continue
  fi

  # Copy raw files to the raw subdirectory
  if [[ "$extension" == "RW2" || "$extension" == "DNG" ]]; then
    cp -n "$file" "$RAW_DIR/"
    echo "Copied raw file '$filename' to '$RAW_DIR/'"

  # Copy movie files to the mp4 subdirectory
  elif [[ "$extension" == "MOV" ]]; then
    cp -n "$file" "$MP4_DIR/"
    echo "Copied movie file '$filename' to '$MP4_DIR/'"
  fi
done
